! exec maru2 sleep --timeout 2s
cmp stderr stderr.txt
! exec maru2 sleep-shorter
cmp stderr stderr-shorter.txt

-- tasks.yaml --
schema-version: v0
tasks:
  sleep:
    - run: sleep 10
  sleep-shorter:
    - uses: sleep
      timeout: 2s
